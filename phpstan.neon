includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:

    paths:
        - app/
        - config/
        - database/
        - routes/

    # Level 9 is the highest level
    level: 5

    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false

    # ignoreErrors:
    #     - '#PHPDoc tag @var#'

    excludePaths:
        - ./*/*/FileToBeExcluded.php

